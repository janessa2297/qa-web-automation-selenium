<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Automation Suite" parallel="tests" thread-count="2">
  <listeners>
    <listener class-name="com.portfolio.listeners.TestListener"/>
  </listeners>
  <test name="Authentication"><classes><class name="com.portfolio.tests.LoginTest"/></classes></test>
  <test name="Inventory"><classes><class name="com.portfolio.tests.InventoryTest"/></classes></test>
  <test name="Cart"><classes><class name="com.portfolio.tests.CartTest"/></classes></test>
  <test name="Checkout"><classes><class name="com.portfolio.tests.CheckoutTest"/></classes></test>
  <test name="Menu"><classes><class name="com.portfolio.tests.MenuTest"/></classes></test>
  <test name="Purchase"><classes><class name="com.portfolio.tests.E2EPurchaseTest"/></classes></test>
</suite>
